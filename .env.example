# Application server
HOST=0.0.0.0
PORT=8000
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Model / vectorizer files (promoted robust TF-IDF + LogisticRegression detector;
# legacy my_model.h5 / countvectorizer.pkl are preserved as rollback backups)
MODEL_PATH=my_model_lr.pkl
VECTORIZER_PATH=my_tfidf_vectorizer.pkl

# Prediction behaviour
# Verdict is "uncertain" when the winning probability is within this distance of 50%.
UNCERTAINTY_THRESHOLD=0.10
# How many influential words to return in the explanation.
TOP_FEATURES=10

# Input validation
MAX_INPUT_LENGTH=20000

# URL analysis
MAX_URL_RESPONSE_SIZE=1000000
REQUEST_TIMEOUT=10
# Timeout (seconds) for establishing the TCP/TLS connection.
CONNECT_TIMEOUT=5
MAX_REDIRECTS=5

# CORS (comma-separated origins; use * for all during development)
CORS_ORIGINS=*
